<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MogHouse.App.ViewModels"
             xmlns:ffxi="using:MogHouse.Core.Ffxi"
             x:Class="MogHouse.App.Views.CharacterSelectView"
             x:DataType="vm:CharacterSelectViewModel">
  <StackPanel Width="460" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
    <TextBlock Text="Select a character" FontSize="22" FontWeight="Light" HorizontalAlignment="Center"/>

    <ListBox ItemsSource="{Binding Characters}"
             SelectedItem="{Binding SelectedCharacter}"
             Height="280">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="ffxi:FfxiCharacter">
          <Grid ColumnDefinitions="Auto,*" Margin="4">

            <!-- Generated avatar. A real portrait needs the model files;
                 this at least distinguishes characters at a glance. -->
            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22"
                    Background="{Binding AvatarColour}" Margin="0,0,10,0">
              <TextBlock Text="{Binding Initial}"
                         FontSize="20" FontWeight="SemiBold" Foreground="#111"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="{Binding Name}" FontSize="16"/>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding RaceName}" Opacity="0.75" FontSize="12"/>
                <TextBlock Text="{Binding JobSummary}" Opacity="0.75" FontSize="12"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding WorldName}" Opacity="0.45" FontSize="11"/>
                <TextBlock Text="{Binding ZoneName}" Opacity="0.45" FontSize="11"/>
                <TextBlock Text="{Binding FaceHair}" Opacity="0.35" FontSize="11"/>
              </StackPanel>
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <Grid ColumnDefinitions="*,Auto">
      <Button Grid.Column="0"
              Content="Enter world"
              Command="{Binding EnterWorldCommand}"
              IsEnabled="{Binding !IsBusy}"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Center"/>
      <Button Grid.Column="1"
              Content="Sign out"
              Command="{Binding SignOutCommand}"
              Margin="6,0,0,0"/>
    </Grid>

    <TextBlock Text="{Binding Error}"
               Foreground="#EF5350"
               TextWrapping="Wrap"
               IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"/>
  </StackPanel>
</UserControl>

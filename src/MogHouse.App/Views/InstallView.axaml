<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MogHouse.App.ViewModels"
             x:Class="MogHouse.App.Views.InstallView"
             x:DataType="vm:InstallViewModel">
  <StackPanel Width="440" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
    <TextBlock Text="MogHouse" FontSize="28" FontWeight="Light" HorizontalAlignment="Center"/>
    <TextBlock Text="Find Final Fantasy XI" Opacity="0.6" HorizontalAlignment="Center"/>

    <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,6,0,0"
               Text="This client reads the game's own files and ships none of them, so it needs to know where they are. Pick the folder called FINAL FANTASY XI - the one with FTABLE.DAT, VTABLE.DAT and ROM inside it."/>

    <TextBlock TextWrapping="Wrap" Opacity="0.45" FontSize="11"
               Text="Picking the ROM folder, or one of the numbered folders inside it, is fine - it will work out what you meant."/>

    <Button Content="Choose the folder..."
            Command="{Binding BrowseCommand}"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Center"
            Margin="0,6,0,0"/>

    <TextBlock Text="{Binding Chosen}" Opacity="0.5" FontSize="11" TextWrapping="Wrap"
               IsVisible="{Binding Chosen, Converter={x:Static ObjectConverters.IsNotNull}}"/>

    <TextBlock Text="{Binding Error}"
               Foreground="#EF5350"
               TextWrapping="Wrap"
               IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"/>
  </StackPanel>
</UserControl>

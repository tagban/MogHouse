<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MogHouse.App.ViewModels"
             xmlns:ffxi="using:MogHouse.Core.Ffxi"
             x:Class="MogHouse.App.Views.LoginView"
             x:DataType="vm:LoginViewModel">
  <StackPanel Width="360" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
    <TextBlock Text="MogHouse" FontSize="28" FontWeight="Light" HorizontalAlignment="Center"/>
    <TextBlock Text="Connect to a server" Opacity="0.6" HorizontalAlignment="Center" Margin="0,0,0,6"/>

    <TextBlock Text="Saved servers"/>
    <Grid ColumnDefinitions="*,Auto">
      <ComboBox Grid.Column="0"
                ItemsSource="{Binding Profiles}"
                SelectedItem="{Binding SelectedProfile}"
                HorizontalAlignment="Stretch"
                PlaceholderText="(none saved yet)">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="ffxi:FfxiServerProfile">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{Binding Name}"/>
              <TextBlock Text="{Binding Username}" Opacity="0.6"/>
              <TextBlock Text="{Binding Host}" Opacity="0.45"/>
            </StackPanel>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <Button Grid.Column="1" Content="Delete" Command="{Binding DeleteProfileCommand}" Margin="6,0,0,0"/>
    </Grid>

    <TextBlock Text="Profile name" Margin="0,6,0,0"/>
    <TextBox Text="{Binding ProfileName}" Watermark="e.g. Local dev"/>

    <Grid ColumnDefinitions="*,Auto" >
      <StackPanel Grid.Column="0">
        <TextBlock Text="Host"/>
        <TextBox Text="{Binding Host}"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Margin="6,0,0,0" Width="80">
        <TextBlock Text="Port"/>
        <TextBox Text="{Binding AuthPort}"/>
      </StackPanel>
    </Grid>

    <TextBlock Text="Username"/>
    <TextBox Text="{Binding Username}"/>

    <TextBlock Text="Password"/>
    <TextBox Text="{Binding Password}" PasswordChar="•"/>

    <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
      <Button Grid.Column="0"
              Content="Log in"
              Command="{Binding LoginCommand}"
              IsEnabled="{Binding !IsBusy}"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Center"/>
      <Button Grid.Column="1" Content="Save profile" Command="{Binding SaveProfileCommand}" Margin="6,0,0,0"/>
    </Grid>

    <Button Content="Create an account on this server"
            Command="{Binding CreateAccountCommand}"
            HorizontalAlignment="Center"
            Background="Transparent"
            BorderThickness="0"
            Opacity="0.7"/>

    <TextBlock Text="{Binding Error}"
               Foreground="#EF5350"
               TextWrapping="Wrap"
               IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"/>
  </StackPanel>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MogHouse.App.ViewModels"
             x:Class="MogHouse.App.Views.CreateCharacterView"
             x:DataType="vm:CreateCharacterViewModel">
  <StackPanel Width="380" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
    <TextBlock Text="New character" FontSize="28" FontWeight="Light" HorizontalAlignment="Center"/>
    <TextBlock Text="They are standing in the other window" Opacity="0.6" HorizontalAlignment="Center" Margin="0,0,0,6"/>

    <TextBlock Text="Name"/>
    <TextBox Text="{Binding Name}" Watermark="3 to 15 letters"/>

    <TextBlock Text="Race"/>
    <ComboBox ItemsSource="{Binding Races}" SelectedItem="{Binding SelectedRace}"
              DisplayMemberBinding="{Binding Name}" HorizontalAlignment="Stretch"/>

    <TextBlock Text="Face and hair"/>
    <Grid ColumnDefinitions="*,Auto">
      <Slider Grid.Column="0" Minimum="0" Maximum="15" Value="{Binding Face}"
              TickFrequency="1" IsSnapToTickEnabled="True"/>
      <TextBlock Grid.Column="1" Text="{Binding Face}" VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.7"/>
    </Grid>

    <TextBlock Text="Build"/>
    <ComboBox ItemsSource="{Binding Sizes}" SelectedItem="{Binding SelectedSize}"
              DisplayMemberBinding="{Binding Name}" HorizontalAlignment="Stretch"/>

    <TextBlock Text="Starting job"/>
    <ComboBox ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}"
              DisplayMemberBinding="{Binding Name}" HorizontalAlignment="Stretch"/>

    <TextBlock Text="Nation"/>
    <ComboBox ItemsSource="{Binding Nations}" SelectedItem="{Binding SelectedNation}"
              DisplayMemberBinding="{Binding Name}" HorizontalAlignment="Stretch"/>

    <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
      <Button Grid.Column="0"
              Content="Create"
              Command="{Binding CreateCommand}"
              IsEnabled="{Binding !IsBusy}"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Center"/>
      <Button Grid.Column="1" Content="Back" Command="{Binding BackCommand}" Margin="6,0,0,0"/>
    </Grid>

    <TextBlock Text="{Binding Error}"
               Foreground="#EF5350"
               TextWrapping="Wrap"
               IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"/>
  </StackPanel>
</UserControl>

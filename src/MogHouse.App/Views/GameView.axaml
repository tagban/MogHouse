<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:app="clr-namespace:MogHouse.App"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MogHouse.App.ViewModels"
             xmlns:ffxi="using:MogHouse.Core.Ffxi"
             xmlns:controls="using:MogHouse.App.Controls"
             x:Class="MogHouse.App.Views.GameView"
             x:DataType="vm:GameViewModel">
  <UserControl.Resources>
    <app:FirstLinkConverter x:Key="FirstLink"/>
  </UserControl.Resources>

  <Panel>
  <Grid ColumnDefinitions="*,320" Margin="10">

    <!-- Chat -->
    <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto" Margin="0,0,10,0">
      <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
        <TextBlock Text="{Binding CharacterName}" FontSize="18"/>
        <TextBlock Text="{Binding PositionText}" Opacity="0.6" VerticalAlignment="Center"/>
      </StackPanel>

      <Border Grid.Row="1" BorderBrush="#333" BorderThickness="1" CornerRadius="4">
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding ChatLines}" Margin="6">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="ffxi:FfxiChatLine">
                <!-- Plain TextBlocks rather than Runs: Avalonia's Run does not
                     support every property through a binding, and failures are
                     silent, which is how the chat box ended up empty. -->
                <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,1"
                            Background="Transparent" Tapped="OnChatLineTapped"
                            ToolTip.Tip="{Binding Text, Converter={StaticResource FirstLink}}">
                  <TextBlock Text="{Binding Kind}" Foreground="#7E9CD8" FontSize="12" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Sender}" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>

      <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,8,0,0">
        <TextBox Grid.Column="0"
                 Name="ChatInput"
                 Text="{Binding Input}"
                 KeyDown="OnChatKeyDown"
                 PlaceholderText="Say something, /tell Name message, or !gmcommand"/>
        <Button Grid.Column="1" Content="Send" Command="{Binding SendCommand}" Margin="6,0,0,0"/>
        <Button Grid.Column="2" Content="Log out" Command="{Binding LogoutCommand}" Margin="6,0,0,0"/>
      </Grid>
    </Grid>

    <!-- The world is its own window; this side reports on it. -->
    <StackPanel Grid.Column="1" Spacing="8">
      <TextBlock Text="World" FontSize="16"/>
      <Border BorderBrush="#333" BorderThickness="1" CornerRadius="4" Padding="10">
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding WorldStatus}" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding PositionText}" Opacity="0.7" FontSize="12"/>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="players" Opacity="0.5" FontSize="12"/>
            <TextBlock Text="{Binding PlayerCount}" Opacity="0.85" FontSize="12"/>
            <TextBlock Text="npcs" Opacity="0.5" FontSize="12" Margin="8,0,0,0"/>
            <TextBlock Text="{Binding NpcCount}" Opacity="0.85" FontSize="12"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <Button Content="Reopen the world window" Command="{Binding ReopenWorldCommand}"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>

      <TextBlock Opacity="0.4" FontSize="11" TextWrapping="Wrap"
                 Text="Movement, chat and the camera are in the world window. WASD or the numpad walks, shift walks slowly, return opens a line to type, space jumps, the wheel or numpad 9 and 3 move the camera."/>

      <Button Content="Leave the world" Command="{Binding LeaveCommand}"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,10,0,0"/>

      <Border BorderBrush="#333" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,8,0,0">
        <StackPanel Spacing="4">
          <TextBlock Text="Found something wrong?" Opacity="0.55" FontSize="11"/>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Content="Report a bug" Click="OnReportBug" FontSize="12" Padding="8,3"/>
            <Button Content="Discord" Click="OnOpenDiscord" FontSize="12" Padding="8,3"/>
          </StackPanel>
          <TextBlock Opacity="0.4" FontSize="11" TextWrapping="Wrap"
                     Text="Bugs go to GitHub Issues. The Discord is where the work happens - say what you were doing and what the window showed, and a screenshot beats a description."/>
        </StackPanel>
      </Border>
    </StackPanel>
  </Grid>

    <!-- Loading. Covers the page rather than sitting in it: the panel behind
         is describing a world that has already been torn down, and a Leave
         button that acts on a disposed window is worse than no button. -->
    <Border IsVisible="{Binding IsZoning}" Background="#E6101418">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="18">
        <Image Source="/Assets/moghouse.ico" Width="96" Height="96"
               HorizontalAlignment="Center" RenderTransformOrigin="0.5,1.0">
          <Image.Styles>
            <!-- A hop rather than a spinner. Slower on the way up than the way
                 down, because that is what falling looks like. -->
            <Style Selector="Image">
              <Style.Animations>
                <Animation Duration="0:0:0.85" IterationCount="INFINITE" Easing="SineEaseInOut">
                  <KeyFrame Cue="0%">
                    <Setter Property="RenderTransform" Value="translateY(0px) scale(1.0, 1.0)"/>
                  </KeyFrame>
                  <KeyFrame Cue="45%">
                    <Setter Property="RenderTransform" Value="translateY(-26px) scale(1.0, 1.0)"/>
                  </KeyFrame>
                  <KeyFrame Cue="90%">
                    <Setter Property="RenderTransform" Value="translateY(0px) scale(1.06, 0.94)"/>
                  </KeyFrame>
                  <KeyFrame Cue="100%">
                    <Setter Property="RenderTransform" Value="translateY(0px) scale(1.0, 1.0)"/>
                  </KeyFrame>
                </Animation>
              </Style.Animations>
            </Style>
          </Image.Styles>
        </Image>

        <TextBlock Text="{Binding ZoningTo}" FontSize="24" HorizontalAlignment="Center"/>
        <TextBlock Text="Loading" Opacity="0.5" FontSize="12" HorizontalAlignment="Center"/>
      </StackPanel>
    </Border>
  </Panel>
</UserControl>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- A windowed application: the renderer opens the only window, and a
         console beside it would be a second one nobody asked for. Everything
         the client says goes to the log instead - see Program.StartLogging. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The taskbar and the .exe itself. -->
    <ApplicationIcon>Assets\moghouse.ico</ApplicationIcon>

    <!-- What the player double-clicks. The assembly keeps its dotted name so
         namespaces and the build are unaffected; only the file is renamed. -->
    <AssemblyName>MogHouse XI</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MogHouse.Core\MogHouse.Core.csproj" />
  </ItemGroup>

  <!-- The runtime files, staged into the build output in the same shape a
       packaged build has them.

       Without this a development build opens a window and stops: no key
       tables means no zone decrypts, so even the sign-in backdrop fails, and
       the screen that would have said why is drawn into a world that never
       loaded. Only the packaged app had ever worked, which made every test a
       full package-and-notarize cycle.

       Both are found relative to the executable, so mirroring the packaged
       layout here means no search path has to know about a repository. -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\keys\*.bin"
          Link="keys\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(MSBuildThisFileDirectory)..\..\renderer\assets\**\*"
          Link="assets\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- A windowed application: the renderer opens the only window, and a
         console beside it would be a second one nobody asked for. Everything
         the client says goes to the log instead - see Program.StartLogging. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The taskbar and the .exe itself. -->
    <ApplicationIcon>Assets\moghouse.ico</ApplicationIcon>

    <!-- What the player double-clicks. The assembly keeps its dotted name so
         namespaces and the build are unaffected; only the file is renamed. -->
    <AssemblyName>MogHouse XI</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MogHouse.Core\MogHouse.Core.csproj" />
  </ItemGroup>
</Project>
